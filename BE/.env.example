# StudyConnect Backend — Environment Template
# Copy to .env and fill in real values.

DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Google Gemini (fallback khi n8n offline)
GEMINI_API_KEY=

# n8n (bắt buộc theo yêu cầu giảng viên — ưu tiên trước Gemini trực tiếp)
# Import workflow: ../n8n/studyconnect-ai-workflow.json
N8N_WEBHOOK_URL=http://localhost:5678/webhook/studyconnect-ai
N8N_EVENT_WEBHOOK_URL=http://localhost:5678/webhook/studyconnect-events
N8N_WEBHOOK_SECRET=

# PayOS Payment Gateway
PAYOS_CLIENT_ID=2f76ac30-fef8-4570-a2b4-b71e5c08869b
PAYOS_API_KEY=e6c40d9f-18ef-484a-9558-e3996766f758
PAYOS_CHECKSUM_KEY=69ccf465188f058289f7efcf4b54ee77203d53c3af1e40982c42905dfe847910

